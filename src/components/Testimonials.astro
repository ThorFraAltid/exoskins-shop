---
import { getCollection } from 'astro:content';

/**
 * Testimonials slider, Figma 901:681 (Home) / 7040:1062 (Item). 1240 x 625 at 1440:
 * dark block, green 1px border, radius 45; speech bubbles 606 wide with 50px
 * gaps, the active one in the centre and its neighbours peeking at the edges;
 * arrows and star dots below.
 *
 * Props
 * - figma?:        Figma node id -> data-figma (default '901:681')
 * - initialIndex?: slide shown first (default 1 = "Rune Lademann Søndergaard",
 *                  the centre bubble in the Figma render)
 * - label?:        accessible name of the carousel (default 'Customer testimonials')
 *
 * Data: the `testimonials` collection, sorted by `order` (Figma order, left to
 * right). One star dot per testimonial.
 * Behaviour (PLAN.md): no loop (arrows disable at the ends), no autoplay,
 * Left/Right/Home/End keys while focus is inside, dots, swipe on touch.
 * Instant slide change with prefers-reduced-motion.
 */
interface Props {
  figma?: string;
  initialIndex?: number;
  label?: string;
}

const {
  figma = '901:681',
  initialIndex = 1,
  label = 'Customer testimonials',
} = Astro.props;

const items = (await getCollection('testimonials')).sort((a, b) => a.data.order - b.data.order);
if (items.length === 0) {
  throw new Error('Testimonials: the testimonials collection is empty');
}
if (initialIndex < 0 || initialIndex >= items.length) {
  throw new Error(`Testimonials: initialIndex ${initialIndex} is outside 0..${items.length - 1}`);
}
const STAR = 'M7.0099 2.05941L14 0L11.9604 7.0099L14 14L7.0099 11.9604L0 14L2.05941 7.0099L0 0L7.0099 2.05941Z';
const ARROW =
  'M21.5 12.5459C22.3284 12.5459 23 11.8744 23 11.0459C23 10.2175 22.3284 9.54594 21.5 9.54594L21.5 11.0459L21.5 12.5459ZM0.43934 9.98528C-0.146447 10.5711 -0.146447 11.5208 0.43934 12.1066L9.98528 21.6525C10.5711 22.2383 11.5208 22.2383 12.1066 21.6525C12.6924 21.0668 12.6924 20.117 12.1066 19.5312L3.62132 11.0459L12.1066 2.56066C12.6924 1.97487 12.6924 1.02513 12.1066 0.439341C11.5208 -0.146446 10.5711 -0.146446 9.98528 0.43934L0.43934 9.98528ZM21.5 11.0459L21.5 9.54594L1.5 9.54594L1.5 11.0459L1.5 12.5459L21.5 12.5459L21.5 11.0459Z';
const last = items.length - 1;
---

<section
  class="testimonials"
  data-figma={figma}
  aria-roledescription="carousel"
  aria-label={label}
  data-testimonials
  data-slider
  data-index={initialIndex}
  style={`--index: ${initialIndex}`}
>
  <div class="testimonials__viewport">
    <ul class="testimonials__track" role="list" aria-live="polite" data-track>
      {
        items.map((item, i) => (
          <li
            class="testimonials__slide"
            role="group"
            aria-roledescription="slide"
            aria-label={`${i + 1} of ${items.length}`}
            aria-hidden={i === initialIndex ? undefined : 'true'}
            data-slide
            data-active={i === initialIndex ? '' : undefined}
          >
            <figure class="testimonials__card">
              <blockquote class="testimonials__bubble">
                <p>{item.data.quote}</p>
                <svg
                  class="testimonials__tail"
                  width="53.2774"
                  height="28.048"
                  viewBox="56.3613 237.952 53.2774 28.048"
                  aria-hidden="true"
                >
                  <path d="M109.639 237.952L83 266L56.3613 237.952Z" />
                </svg>
              </blockquote>
              <figcaption class="testimonials__who">
                <span class="testimonials__name">{item.data.name}</span>
                <span class="testimonials__role">{item.data.role}</span>
              </figcaption>
            </figure>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="testimonials__nav">
    <button
      class="testimonials__arrow"
      type="button"
      aria-label="Previous testimonial"
      disabled={initialIndex === 0}
      data-prev
      data-slider-prev
    >
      <svg width="23" height="22.0919" viewBox="0 0 23 22.0919" aria-hidden="true">
        <path d={ARROW}></path>
      </svg>
    </button>
    <div class="testimonials__dots">
      {
        items.map((_, i) => (
          <button
            class="testimonials__dot"
            type="button"
            aria-label={`Show testimonial ${i + 1}`}
            aria-current={i === initialIndex ? 'true' : undefined}
            data-dot={i}
          >
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d={STAR} />
            </svg>
          </button>
        ))
      }
    </div>
    <button
      class="testimonials__arrow testimonials__arrow--next"
      type="button"
      aria-label="Next testimonial"
      disabled={initialIndex === last}
      data-next
      data-slider-next
    >
      <svg width="23" height="22.0919" viewBox="0 0 23 22.0919" aria-hidden="true">
        <path d={ARROW}></path>
      </svg>
    </button>
  </div>
</section>

<style>
  .testimonials {
    /* Desktop geometry (Figma): bubble 606, gap 50; the centre bubble sits 7px
       left of the block centre in the design. */
    --slide-w: 606px;
    --gap: 50px;
    --shift: -7px;
    --pad-x: 52px;
    --pad-top: 48px;
    --tail-x: 56.3613px;
    --who-pad: 80px;
    position: relative;
    width: var(--column);
    margin-inline: auto;
    /* Figma: bubbles 84px below the block top edge, block 625 tall */
    min-height: 625px;
    padding: 83px 0 40px;
    container-type: inline-size;
    overflow: hidden;
    background: var(--c-dark);
    border: var(--border);
    border-radius: var(--r-card);
  }
  .testimonials__viewport {
    position: relative;
    touch-action: pan-y;
  }
  .testimonials__track {
    display: flex;
    align-items: flex-start;
    gap: var(--gap);
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    margin-left: calc(50% - var(--slide-w) / 2 + var(--shift));
    transform: translateX(calc(var(--index) * -1 * (var(--slide-w) + var(--gap))));
    transition: transform 400ms var(--ease);
  }
  .testimonials__slide {
    flex: none;
    width: var(--slide-w);
  }
  .testimonials__card {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin: 0;
  }
  .testimonials__bubble {
    position: relative;
    margin: 0 0 28.048px;
    min-height: 237.952px;
    padding: var(--pad-top) var(--pad-x);
    background: var(--c-green);
    color: var(--c-black);
    border-radius: var(--r-card);
    font-size: var(--fs-p);
    line-height: var(--lh-p);
  }
  .testimonials__tail {
    position: absolute;
    top: 100%;
    left: var(--tail-x);
    width: 53.2774px;
    height: 28.048px;
    fill: var(--c-green);
  }
  .testimonials__who {
    display: flex;
    flex-direction: column;
    padding-left: var(--who-pad);
    line-height: var(--lh-auto);
  }
  .testimonials__name {
    color: var(--c-green);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
  }
  .testimonials__role {
    color: var(--c-white);
    font-size: var(--fs-p);
  }

  .testimonials__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(564px, 100% - 48px);
    height: 14px;
    margin: 125px 0 0 calc(50% - min(564px, 100% - 48px) / 2 + var(--shift));
  }
  /* Figma arrow: a 20px wide line (height 0); the button is a 44px hit area
     around it with negative margins, so the layout footprint stays 20 x 0. */
  .testimonials__arrow {
    position: relative;
    flex: none;
    width: 44px;
    height: 44px;
    margin: -22px -12px;
    color: var(--c-white);
    transition: color var(--dur) var(--ease);
  }
  .testimonials__arrow svg {
    position: absolute;
    left: 10.5px;
    top: 10.95px;
    width: 23px;
    height: 22.0919px;
    fill: currentColor;
  }
  .testimonials__arrow--next svg {
    transform: rotate(180deg);
  }
  .testimonials__arrow:hover:not(:disabled) {
    color: var(--c-green);
  }
  .testimonials__arrow:disabled {
    color: var(--c-white-30);
    cursor: default;
  }
  .testimonials__dots {
    display: flex;
    gap: 9px;
    /* 24px hit areas, star pitch 33px as in the Figma "Stars" group */
    margin-inline: -5px;
  }
  .testimonials__dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    margin-block: -5px;
  }
  .testimonials__dot svg {
    width: 14px;
    height: 14px;
    fill: var(--c-white);
    transition: fill var(--dur) var(--ease);
  }
  .testimonials__dot[aria-current='true'] svg {
    fill: var(--c-green);
  }
  .testimonials__dot:hover svg {
    fill: var(--c-green);
  }

  @media (max-width: 1239px) {
    .testimonials {
      --slide-w: 60cqi;
      --shift: 0px;
      min-height: 0;
      padding-block: 64px 56px;
    }
    .testimonials__nav {
      margin-top: 80px;
      margin-left: calc(50% - min(564px, 100% - 48px) / 2);
    }
  }
  @media (max-width: 1023px) {
    .testimonials {
      --slide-w: 72cqi;
      --gap: 32px;
      --pad-x: 40px;
      --pad-top: 40px;
      --who-pad: 56px;
      --tail-x: 40px;
    }
  }
  @media (max-width: 767px) {
    .testimonials {
      --slide-w: 84cqi;
      --gap: 16px;
      --pad-x: 24px;
      --pad-top: 28px;
      --who-pad: 24px;
      --tail-x: 24px;
      padding-block: 40px;
      border-radius: var(--r-card);
    }
    .testimonials__bubble {
      min-height: 0;
      padding-bottom: 32px;
    }
    .testimonials__nav {
      margin-top: 48px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .testimonials__track {
      transition: none;
    }
  }
</style>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-testimonials]')) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-next]');
    const viewport = root.querySelector<HTMLElement>('.testimonials__viewport');
    if (!prev || !next || !viewport || slides.length === 0) {
      throw new Error('Testimonials: slider markup is incomplete');
    }
    const last = slides.length - 1;
    let index = Number(root.dataset.index);

    const go = (target: number) => {
      index = Math.max(0, Math.min(last, target));
      root.style.setProperty('--index', String(index));
      root.dataset.index = String(index);
      slides.forEach((slide, i) => {
        if (i === index) slide.removeAttribute('aria-hidden');
        else slide.setAttribute('aria-hidden', 'true');
        slide.toggleAttribute('data-active', i === index);
      });
      dots.forEach((dot, i) => {
        if (i === index) dot.setAttribute('aria-current', 'true');
        else dot.removeAttribute('aria-current');
      });
      prev.disabled = index === 0;
      next.disabled = index === last;
    };

    prev.addEventListener('click', () => go(index - 1));
    next.addEventListener('click', () => go(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));

    root.addEventListener('keydown', (event) => {
      const keys: Record<string, number> = {
        ArrowLeft: index - 1,
        ArrowRight: index + 1,
        Home: 0,
        End: last,
      };
      const target = keys[event.key];
      if (target === undefined) return;
      event.preventDefault();
      go(target);
      // Keep focus on a usable control when an arrow becomes disabled.
      if (document.activeElement instanceof HTMLButtonElement && document.activeElement.disabled) {
        dots[index]?.focus();
      }
    });

    let startX: number | null = null;
    viewport.addEventListener('pointerdown', (event) => {
      startX = event.clientX;
    });
    viewport.addEventListener('pointerup', (event) => {
      if (startX === null) return;
      const dx = event.clientX - startX;
      startX = null;
      if (Math.abs(dx) > 40) go(dx < 0 ? index + 1 : index - 1);
    });
    viewport.addEventListener('pointercancel', () => {
      startX = null;
    });
  }
</script>
