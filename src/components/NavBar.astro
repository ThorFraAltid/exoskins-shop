---
import Button from './Button.astro';
import { url } from '../lib/url';
import { NAV_ITEMS, BASKET_LINK } from '../data/site';

/**
 * Navigation bar: logo, About eXo, FAQ, Go to skins, "Shopping basket"
 * outline button. Below 1024px: logo + 44px menu button that opens a
 * full-height menu panel (Esc closes, focus trapped, body scroll locked).
 *
 * Props
 * - variant: 'hero' | 'bar'
 *     'hero'  the nav row only (Figma 3069:924, 1240x68). The Home hero places it
 *             inside the header box (Figma: 26px from the top, 1px from the left).
 *             Width = its container.
 *     'bar'   Item page header (Figma 5190:1435): 1240x121 black pill (radius 300),
 *             nav row 26px from its top, placed 23px below the page top in the
 *             1240 column. Use at the very top of the page.
 * - homeHref?: logo link target, default url('/')
 * - class?:    extra class on the root
 *
 * Pending links (About eXo, FAQ) render as <a> without href (PLAN.md finding 5).
 */
interface Props {
  variant: 'hero' | 'bar';
  homeHref?: string;
  class?: string;
}

const { variant, homeHref = url('/'), class: className } = Astro.props;
const figma = variant === 'bar' ? '5190:1435' : '3069:924';
const logoSrc = url('media/brand/logo-pos.svg');
const basketHref = BASKET_LINK.pending ? undefined : BASKET_LINK.href;
---

<header
  class:list={['navbar', `navbar--${variant}`, className]}
  data-figma={figma}
  data-navbar
>
  <nav class="navbar__row" aria-label="Main">
    <a class="navbar__logo" href={homeHref}>
      <img src={logoSrc} alt="eXo home" width="180" height="48" />
    </a>
    <ul class="navbar__links" role="list">
      {
        NAV_ITEMS.map((item) => (
          <li>
            {item.pending ? (
              <a class="navbar__link" data-pending>
                {item.label}
              </a>
            ) : (
              <a class="navbar__link" href={url(item.href)}>
                {item.label}
              </a>
            )}
          </li>
        ))
      }
      <li>
        <Button
          variant="secondary"
          onDark
          href={basketHref}
          external={BASKET_LINK.external}
          class="navbar__basket">{BASKET_LINK.label}</Button
        >
      </li>
    </ul>
    <button
      class="navbar__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
      data-menu-open
      data-menu-button
    >
      <svg width="44" height="44" viewBox="0 0 58 58" aria-hidden="true">
        <circle cx="29" cy="29" r="28.5" class="navbar__toggle-bg"></circle>
        <path d="M16 25.72H41.08V31.36H16Z" class="navbar__toggle-fg navbar__toggle-h"></path>
        <path d="M25.6 16H31.48V41.08H25.6Z" class="navbar__toggle-fg navbar__toggle-v"></path>
      </svg>
    </button>
  </nav>

  <div
    class="menu"
    id="mobile-menu"
    role="dialog"
    aria-modal="true"
    aria-label="Menu"
    hidden
    data-menu
  >
    <ul class="menu__links" role="list">
      {
        NAV_ITEMS.map((item) => (
          <li>
            {item.pending ? (
              <a class="navbar__link" data-pending>
                {item.label}
              </a>
            ) : (
              <a class="navbar__link" href={url(item.href)} data-menu-link>
                {item.label}
              </a>
            )}
          </li>
        ))
      }
    </ul>
    <Button
      variant="secondary"
      onDark
      fullWidth
      href={basketHref}
      external={BASKET_LINK.external}>{BASKET_LINK.label}</Button
    >
  </div>
</header>

<style>
  .navbar--bar {
    width: var(--column);
    margin: 23px auto 0;
    height: 121px;
    padding-top: 26px;
    background: var(--c-black);
    border-radius: var(--r-pill);
  }
  .navbar__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 68px;
    padding-inline: 100px;
  }
  .navbar__logo {
    display: block;
    flex: none;
    /* Figma Logo instance: 219.54 x 36 box, artwork 180 x 48 at y -3 */
    width: 219.537px;
    height: 36px;
  }
  .navbar__logo img {
    width: 180px;
    height: 48px;
    margin-top: -3px;
  }
  .navbar__links {
    display: flex;
    align-items: center;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .navbar__link {
    font-size: var(--fs-label);
    line-height: var(--lh-label);
    color: var(--c-grey);
    text-decoration: none;
    white-space: nowrap;
  }
  a.navbar__link[href]:hover {
    color: var(--c-green);
  }
  .navbar__toggle {
    display: none;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
  }
  .navbar__toggle svg {
    width: 44px;
    height: 44px;
  }
  .navbar__toggle-bg {
    fill: var(--c-grey);
    stroke: var(--c-dark);
  }
  .navbar__toggle-fg {
    fill: var(--c-dark);
    transform-origin: 28.54px 28.54px;
    transition: transform 320ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  /* open: the plus folds into the Figma minus (17.76 wide) */
  .navbar__toggle[aria-expanded='true'] .navbar__toggle-v {
    transform: rotate(90deg) scaleY(0);
  }
  .navbar__toggle[aria-expanded='true'] .navbar__toggle-h {
    transform: scaleX(0.708);
  }

  /* The panel opens under the nav row: logo and button never move. */
  .navbar__row {
    position: relative;
    z-index: 101;
  }
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    gap: 40px;
    height: 100dvh;
    /* --menu-top: bottom edge of the nav row, set when the menu opens */
    padding: calc(var(--menu-top, 96px) + 40px) var(--gutter) 32px;
    overflow-y: auto;
    background: var(--c-black);
    opacity: 0;
    transition: opacity 320ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .menu > :global(*) {
    opacity: 0;
    translate: 0 16px;
    transition:
      opacity 320ms cubic-bezier(0.65, 0, 0.35, 1),
      translate 320ms cubic-bezier(0.65, 0, 0.35, 1);
  }
  .menu.is-open,
  .menu.is-open > :global(*) {
    opacity: 1;
    translate: none;
  }
  .menu.is-open > :global(:nth-child(2)) {
    transition-delay: 70ms;
  }
  .menu[hidden] {
    display: none;
  }
  .menu__links {
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (max-width: 1239px) {
    .navbar__row {
      padding-inline: clamp(40px, calc(40px + (100% - 960px) * 60 / 280), 100px);
    }
  }
  @media (max-width: 1023px) {
    .navbar__links {
      display: none;
    }
    .navbar__toggle {
      display: block;
    }
    .navbar__row {
      padding-inline: 24px;
    }
    .navbar--bar {
      height: auto;
      padding-block: 12px;
    }
  }
  @media (max-width: 767px) {
    .navbar__row {
      padding-inline: 20px;
    }
    .navbar--bar {
      margin-top: 16px;
    }
  }
</style>

<script>
  const FOCUSABLE = 'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])';

  for (const root of document.querySelectorAll<HTMLElement>('[data-navbar]')) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-menu-button]');
    const row = root.querySelector<HTMLElement>('.navbar__row');
    const menu = root.querySelector<HTMLElement>('[data-menu]');
    if (!toggle || !row || !menu) {
      throw new Error('NavBar: menu markup is incomplete');
    }
    const CLOSE_MS = 320;
    let hideTimer: number | undefined;
    const isOpen = () => toggle.getAttribute('aria-expanded') === 'true';

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        close();
        return;
      }
      if (event.key !== 'Tab') return;
      // Focus stays within the button and the panel.
      const items = [toggle, ...menu.querySelectorAll<HTMLElement>(FOCUSABLE)];
      const first = items[0]!;
      const last = items[items.length - 1]!;
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    };

    const open = () => {
      window.clearTimeout(hideTimer);
      menu.style.setProperty('--menu-top', `${row.getBoundingClientRect().bottom}px`);
      menu.hidden = false;
      void menu.offsetWidth; // start the fade from the hidden state
      menu.classList.add('is-open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      document.body.classList.add('is-scroll-locked');
      document.addEventListener('keydown', onKeydown);
    };

    function close() {
      menu!.classList.remove('is-open');
      hideTimer = window.setTimeout(() => (menu!.hidden = true), CLOSE_MS);
      toggle!.setAttribute('aria-expanded', 'false');
      toggle!.setAttribute('aria-label', 'Open menu');
      document.body.classList.remove('is-scroll-locked');
      document.removeEventListener('keydown', onKeydown);
      toggle!.focus();
    }

    toggle.addEventListener('click', () => (isOpen() ? close() : open()));
    // In-page links ("Go to skins" -> /#inventory) close the menu before scrolling.
    for (const link of menu.querySelectorAll('[data-menu-link]')) {
      link.addEventListener('click', () => {
        if (isOpen()) close();
      });
    }
    // Leaving the mobile layout while open: close so the page is not left locked.
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (event) => {
      if (event.matches && isOpen()) close();
    });
  }
</script>
