---
import HeadingLabel from './HeadingLabel.astro';
import Button from './Button.astro';
import { url } from '../lib/url';
import {
  NAV_ITEMS,
  CONTACT,
  COPYRIGHT,
  PRIVACY_LINK,
  LINKEDIN_LINK,
  NEWSLETTER_ENDPOINT,
} from '../data/site';

/**
 * Footer, Figma 901:753 (Home) / 7101:893 (Item). 1241 x 555 at 1440, green,
 * top corners 45. Contains the subscribe form (`id="subscribe"`, the target of
 * crate "See more" and "Get notified here").
 *
 * Props
 * - figma?: Figma node id -> data-figma (default '901:753'; Item page: '7101:893')
 *
 * Subscribe (PLAN.md finding 6): the email is validated in the browser. With
 * NEWSLETTER_ENDPOINT empty, a prefilled mail to CONTACT.email opens; when set,
 * the form POSTs `email` (form data) there and shows the result. Messages use
 * the dark "Contact us:" pill style.
 */
interface Props {
  figma?: string;
}

const { figma = '901:753' } = Astro.props;
const linkedinSrc = url('media/icons/linkedin.svg');
---

<footer class="footer" data-figma={figma}>
  <div class="footer__top">
    <div class="footer__elements">
      <a class="footer__logo" href={url('/')}>
        <img src={url('media/brand/logo-neg.svg')} alt="eXo home" width="180" height="48" />
      </a>
      <nav class="footer__nav" aria-label="Footer">
        <ul role="list">
          {
            NAV_ITEMS.map((item) => (
              <li>
                {item.pending ? (
                  <a class="footer__link" data-pending>
                    {item.label}
                  </a>
                ) : (
                  <a class="footer__link" href={url(item.href)}>
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="footer__social">
        {
          LINKEDIN_LINK.pending ? (
            <a class="footer__social-link" data-pending>
              <img src={linkedinSrc} alt={LINKEDIN_LINK.label} width="30" height="30" />
            </a>
          ) : (
            <a
              class="footer__social-link"
              href={LINKEDIN_LINK.href}
              target="_blank"
              rel="noopener"
            >
              <img src={linkedinSrc} alt={LINKEDIN_LINK.label} width="30" height="30" />
            </a>
          )
        }
      </div>
    </div>

    <div class="footer__main">
      <div class="footer__contact">
        <HeadingLabel lines="Contact us:" as="h2" size="h4" tone="dark-green" />
        <address class="footer__info">
          <p>Email: <a href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a></p>
          <p>Phone: <a href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phone}</a></p>
          <p>
            Address: {CONTACT.addressLines[0]}<br />{CONTACT.addressLines[1]}<br />{
              CONTACT.addressLines[2]
            }
          </p>
        </address>
      </div>

      <form
        class="footer__subscribe"
        id="subscribe"
        novalidate
        data-subscribe
        data-endpoint={NEWSLETTER_ENDPOINT}
        data-mailto={CONTACT.email}
        method={NEWSLETTER_ENDPOINT ? 'post' : undefined}
        action={NEWSLETTER_ENDPOINT || undefined}
      >
        <div class="footer__subscribe-row">
          <label class="visually-hidden" for="subscribe-email">Email</label>
          <input
            class="footer__field"
            id="subscribe-email"
            name="email"
            type="email"
            autocomplete="email"
            placeholder="Email"
            required
            aria-describedby="subscribe-status"
          />
          <Button variant="tertiary" type="submit" class="footer__submit">Subscribe to news</Button>
        </div>
        <p class="footer__status" id="subscribe-status" role="status" aria-live="polite" hidden>
        </p>
      </form>
    </div>
  </div>

  <div class="footer__bottom">
    <hr class="footer__line" />
    <div class="footer__legal">
      <p>{COPYRIGHT}</p>
      {
        PRIVACY_LINK.pending ? (
          <a class="footer__link" data-pending>
            {PRIVACY_LINK.label}
          </a>
        ) : (
          <a class="footer__link" href={url(PRIVACY_LINK.href)}>
            {PRIVACY_LINK.label}
          </a>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    --focus-ring: var(--c-black);
    display: flex;
    flex-direction: column;
    gap: 50px;
    /* Figma: 1241 wide, left edge on the 1240 column */
    width: calc(var(--column) + 1px);
    margin-left: calc((100% - var(--column)) / 2);
    padding: 55px 60px 50px;
    background: var(--c-green);
    color: var(--c-dark);
    border-radius: var(--r-card) var(--r-card) 0 0;
    font-size: var(--fs-p);
    line-height: var(--lh-p);
  }
  .footer__top {
    display: flex;
    flex-direction: column;
    gap: 66px;
  }
  .footer__elements {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: 1121px;
  }
  .footer__logo {
    display: block;
    flex: none;
  }
  .footer__logo img {
    width: 180px;
    height: 48px;
  }
  .footer__nav ul {
    display: flex;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer__link {
    color: var(--c-dark);
    text-decoration: underline;
    text-decoration-skip-ink: none;
    text-underline-position: from-font;
    white-space: nowrap;
  }
  a.footer__link[href]:hover {
    color: var(--c-black);
    text-decoration-thickness: 2px;
  }
  .footer__social {
    display: flex;
    flex: none;
  }
  .footer__social-link {
    display: block;
    width: 30px;
    height: 30px;
  }
  .footer__social-link img {
    width: 30px;
    height: 30px;
  }

  .footer__main {
    display: flex;
    align-items: flex-start;
    gap: 154px;
  }
  .footer__contact {
    display: flex;
    flex-direction: column;
    gap: 27px;
    flex: none;
  }
  .footer__info {
    display: flex;
    flex-direction: column;
    gap: 20px;
    font-style: normal;
    white-space: nowrap;
  }
  .footer__info a {
    color: inherit;
    text-decoration: none;
  }
  .footer__info a:hover {
    text-decoration: underline;
  }

  .footer__subscribe {
    display: flex;
    flex-direction: column;
    gap: 20px;
    /* Figma "Subscription block": 40 / 58 padding */
    padding: 58px 40px;
    border-radius: var(--r-button);
  }
  .footer__subscribe-row {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .footer__field {
    width: 285px;
    min-width: 0;
    margin: 0;
    /* Figma Field: 22 / 35 padding, 1px stroke inside */
    padding: 21px 34px;
    border: 1px solid var(--c-dark);
    border-radius: var(--r-button);
    background: transparent;
    color: var(--c-dark);
    font-size: var(--fs-p);
    line-height: var(--lh-auto);
    outline: none;
    appearance: none;
  }
  .footer__field::placeholder {
    color: var(--c-dark);
    opacity: 1;
  }
  /* PLAN.md "States": focus = 2px black border, without moving the text */
  .footer__field:focus-visible {
    border-color: var(--c-black);
    box-shadow: inset 0 0 0 1px var(--c-black);
  }
  .footer__field[aria-invalid='true'] {
    border-color: var(--c-black);
    box-shadow: inset 0 0 0 1px var(--c-black);
  }
  .footer__status {
    align-self: flex-start;
    padding-inline: var(--label-pad-x);
    border-radius: var(--r-label);
    background: var(--c-dark);
    color: var(--c-green);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
  }
  .footer__status[hidden] {
    display: none;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    gap: 50px;
  }
  .footer__line {
    width: 100%;
    max-width: 1120px;
    height: 0;
    margin: 0;
    border: 0;
    border-top: 1px solid var(--c-dark);
  }
  .footer__legal {
    display: flex;
    gap: 40px;
    line-height: 28px;
  }

  @media (max-width: 1239px) {
    .footer__main {
      gap: 40px;
    }
    .footer__subscribe {
      flex: 1 1 auto;
      min-width: 0;
      padding-inline: 0;
    }
    .footer__field {
      flex: 1 1 285px;
    }
  }
  @media (max-width: 1023px) {
    .footer {
      padding: 48px 40px 40px;
    }
    .footer__elements {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        'logo social'
        'nav nav';
      row-gap: 40px;
    }
    .footer__logo {
      grid-area: logo;
    }
    .footer__social {
      grid-area: social;
    }
    .footer__nav {
      grid-area: nav;
    }
    .footer__top {
      gap: 50px;
    }
    .footer__main {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
    }
    .footer__subscribe {
      padding: 0;
    }
    .footer__subscribe-row {
      flex-direction: column;
      align-items: stretch;
    }
    .footer__field {
      flex: none;
      width: 100%;
    }
  }
  @media (max-width: 767px) {
    .footer {
      gap: 40px;
      padding: 40px 24px 32px;
    }
    .footer__nav ul {
      flex-wrap: wrap;
      gap: 16px 40px;
    }
    .footer__main {
      grid-template-columns: 1fr;
    }
    .footer__info {
      white-space: normal;
    }
    .footer__legal {
      flex-direction: column;
      gap: 16px;
    }
  }
</style>

<script>
  const EMAIL = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

  for (const form of document.querySelectorAll<HTMLFormElement>('[data-subscribe]')) {
    const input = form.querySelector<HTMLInputElement>('input[name="email"]');
    const status = form.querySelector<HTMLElement>('[role="status"]');
    if (!input || !status) {
      throw new Error('Footer: subscribe form markup is incomplete');
    }
    const endpoint = form.dataset.endpoint ?? '';
    const mailto = form.dataset.mailto ?? '';

    const show = (message: string) => {
      status.textContent = message;
      status.hidden = false;
    };

    input.addEventListener('input', () => {
      input.removeAttribute('aria-invalid');
      status.hidden = true;
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = input.value.trim();
      if (!EMAIL.test(email)) {
        input.setAttribute('aria-invalid', 'true');
        show('Please enter a valid email address.');
        input.focus();
        return;
      }

      if (!endpoint) {
        const subject = encodeURIComponent('Subscribe to news');
        const body = encodeURIComponent(`Please subscribe ${email} to eXo news.`);
        window.location.href = `mailto:${mailto}?subject=${subject}&body=${body}`;
        show(`Your mail app opens with a message to ${mailto}. Send it to subscribe.`);
        return;
      }

      const response = await fetch(endpoint, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      }).catch((error: unknown) => {
        show('Subscription failed. Please try again.');
        throw error;
      });
      if (!response.ok) {
        show('Subscription failed. Please try again.');
        throw new Error(`Subscribe: ${endpoint} answered ${response.status}`);
      }
      form.reset();
      show('Thanks, you are subscribed.');
    });
  }
</script>
