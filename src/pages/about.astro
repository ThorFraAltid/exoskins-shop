---
/**
 * About eXo (/about/). No Figma frame: built only from existing components,
 * tokens and patterns (nav bar as on the Item page, Heading pills, the card
 * language of radius 45 + 1px green border + 5px green bottom edge, the dark
 * testimonials block, the hero label SVGs, Button, ArrowLink, Footer).
 * Copy: src/data/about.ts (a draft Simon must approve).
 *
 * Motion (only with .motion, i.e. when the visitor allows motion; Base.astro
 * sets it before first paint): on load the title pill wipes in, then the
 * statement lines rise out of their line boxes, then the story eases in,
 * staggered by --enter. Sections further down use the site's [data-reveal]
 * scroll reveal. The page transition into this page is in global.css
 * ("Page transitions", html[data-page='about']).
 */
import Base from '../layouts/Base.astro';
import NavBar from '../components/NavBar.astro';
import HeadingLabel from '../components/HeadingLabel.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Button from '../components/Button.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url';
import {
  ABOUT_TITLE,
  ABOUT_DESCRIPTION,
  ABOUT_STATEMENT,
  STORY_HEADING,
  STORY,
  FOUNDER,
  VALUES_HEADING,
  VALUES,
  CLOSING,
} from '../data/about';

const usp = (file: string) => url(`media/usp/${file}`);
/** Stagger step of the entrance sequence (CSS: --enter * step). */
const enter = (step: number) => `--enter: ${step}`;
const storyStep = ABOUT_STATEMENT.length + 1;
---

<Base title={ABOUT_TITLE} description={ABOUT_DESCRIPTION} page="about">
  <NavBar variant="bar" />
  <main class="about">
    <header class="about__intro column">
      <div class="about__title">
        <HeadingLabel lines={ABOUT_TITLE} as="h1" size="h2" tone="green" />
      </div>
      <p class="about__statement">
        {
          ABOUT_STATEMENT.map((line, i) => (
            <span class="about__line">
              <span class="about__line-inner" style={enter(i + 1)}>
                {line}
              </span>
            </span>
          ))
        }
      </p>
    </header>

    <section class="about__story" aria-labelledby="story">
      <div class="about__heading about__enter" style={enter(storyStep)}>
        <SectionHeading title={STORY_HEADING} id="story" />
      </div>
      <div class="about__story-grid column">
        <div class="about__text about__enter" style={enter(storyStep + 1)}>
          {
            STORY.map((block) => (
              <div class="about__block">
                <h3 class="about__block-heading">{block.heading}</h3>
                {block.paragraphs.map((text) => (
                  <p>{text}</p>
                ))}
              </div>
            ))
          }
        </div>
        <figure class="founder about__enter" style={enter(storyStep + 2)}>
          <blockquote class="founder__quote">
            <p>“{FOUNDER.quote}”</p>
          </blockquote>
          <figcaption class="founder__who">
            <span class="founder__name">{FOUNDER.name}</span>
            <span class="founder__role">{FOUNDER.role}</span>
          </figcaption>
        </figure>
      </div>
    </section>

    <section class="about__values" aria-labelledby="values">
      <div class="about__heading" data-reveal>
        <SectionHeading title={VALUES_HEADING} id="values" />
      </div>
      <ul class="values column" role="list">
        {
          VALUES.map((value) => (
            <li class="value" data-reveal>
              <h3 class="value__label">
                {value.id === 'grip' && (
                  <img src={usp('usp-1.svg')} alt={value.alt} width="134.927" height="40.8193" class="value__one value__one--grip" />
                )}
                {value.id === 'sweatproof' && (
                  <span class="value__pair">
                    <img src={usp('usp-2-icon.svg')} alt="" width="44.5237" height="39.4854" class="value__icon2" />
                    <img src={usp('usp-2-text.svg')} alt={value.alt} width="99.3202" height="10.4052" class="value__text2" />
                  </span>
                )}
                {value.id === 'cut' && (
                  <img src={usp('usp-3.svg')} alt={value.alt} width="138.673" height="40.84" class="value__one value__one--cut" />
                )}
                {value.id === 'thin' && (
                  <span class="value__box4">
                    <img src={usp('usp-4-text.svg')} alt={value.alt} width="106.17" height="9.36339" class="value__text4" />
                    <img src={usp('usp-4-icon.svg')} alt="" width="40.5493" height="39.8184" class="value__icon4" />
                  </span>
                )}
              </h3>
              <p class="value__text">{value.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="closing column" aria-labelledby="closing" data-reveal>
      <div class="closing__copy">
        <div id="closing">
          <HeadingLabel lines={CLOSING.heading} as="h2" size="h2" tone="green" />
        </div>
        <p class="closing__text">{CLOSING.text}</p>
      </div>
      <div class="closing__actions">
        <Button variant="tertiary" href={url(CLOSING.primary.href)}>{CLOSING.primary.label}</Button>
        <ArrowLink variant="white" label={CLOSING.secondary.label} href={CLOSING.secondary.href} />
      </div>
    </section>
  </main>
  <Footer />
</Base>

<style>
  .about {
    /* Home rhythm: 163 / 96 / 64 between sections, headings 40 / 32 above content */
    --space-section: 163px;
    display: flex;
    flex-direction: column;
    padding-bottom: 69px;
  }

  /* ---------------------------------------------------------------- intro */
  .about__intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 40px;
    /* Item page: content 55px under the nav bar */
    margin-top: 96px;
  }
  .about__statement {
    display: flex;
    flex-direction: column;
    font-size: var(--fs-h1);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    color: var(--c-grey);
  }
  .about__line {
    display: block;
  }
  .about__line-inner {
    display: block;
    text-wrap: balance;
  }
  .about__line + .about__line .about__line-inner {
    color: var(--c-green);
  }

  /* ---------------------------------------------------------------- story */
  .about__heading {
    width: 100%;
    margin-top: var(--space-section);
    margin-bottom: 40px;
  }
  .about__story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: start;
    gap: 80px;
  }
  .about__text {
    display: flex;
    flex-direction: column;
    gap: 48px;
    max-width: 62ch;
  }
  .about__block {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .about__block-heading {
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    color: var(--c-green);
  }

  /* Founder: the card language (radius 45, 1px green border, 5px green edge), type only */
  .founder {
    position: sticky;
    top: 40px;
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin: 0;
    padding: var(--card-pad-y) var(--card-pad-l);
    background: var(--c-black);
    border: var(--border);
    border-radius: var(--r-card);
    box-shadow: var(--edge);
  }
  .founder__quote {
    font-size: var(--fs-h3);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    color: var(--c-grey);
  }
  .founder__who {
    display: flex;
    flex-direction: column;
    padding-top: 30px;
    border-top: var(--border);
    line-height: var(--lh-auto);
  }
  .founder__name {
    color: var(--c-green);
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
  }
  .founder__role {
    color: var(--c-white);
    font-size: var(--fs-p);
  }

  /* ---------------------------------------------------------------- values */
  .values {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin-block: 0;
    padding: 0;
    list-style: none;
  }
  .value {
    /* 1u = 1px of the hero label SVGs, shown at 1.4x */
    --u: 1.4px;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 40px 36px;
    background: var(--c-black);
    border: var(--border);
    border-radius: var(--r-card);
    box-shadow: var(--edge);
  }
  .value__label {
    display: flex;
    align-items: center;
    height: calc(41 * var(--u));
  }
  .value__label img {
    max-width: none;
  }
  .value__one--grip {
    width: calc(134.927 * var(--u));
    height: calc(40.8193 * var(--u));
  }
  .value__one--cut {
    width: calc(138.673 * var(--u));
    height: calc(40.84 * var(--u));
  }
  /* Same arrangement as the hero (Hero.astro: usp--2, usp__box4) */
  .value__pair {
    display: flex;
    align-items: center;
    gap: calc(6 * var(--u));
  }
  .value__icon2 {
    width: calc(44.5237 * var(--u));
    height: calc(39.4854 * var(--u));
  }
  .value__text2 {
    width: calc(99.3202 * var(--u));
    height: calc(10.4052 * var(--u));
  }
  .value__box4 {
    position: relative;
    display: block;
    width: calc(152 * var(--u));
    height: calc(40 * var(--u));
  }
  .value__text4 {
    position: absolute;
    left: calc(43.32 * var(--u));
    top: calc(16 * var(--u));
    width: calc(106.17 * var(--u));
    height: calc(9.36339 * var(--u));
  }
  .value__icon4 {
    position: absolute;
    left: calc(-0.134 * var(--u));
    top: calc(0.543 * var(--u));
    width: calc(40.5493 * var(--u));
    height: calc(39.8184 * var(--u));
  }
  .value__text {
    color: var(--c-grey);
  }

  /* ---------------------------------------------------------------- closing */
  /* The dark testimonials block (radius 45, 1px green border) */
  .closing {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin-top: var(--space-section);
    padding: 80px 100px;
    background: var(--c-dark);
    border: var(--border);
    border-radius: var(--r-card);
  }
  .closing__copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    max-width: 580px;
  }
  .closing__text {
    font-size: var(--fs-h4);
    font-weight: var(--fw-medium);
    line-height: var(--lh-heading);
    color: var(--c-grey);
  }
  .closing__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 32px;
    flex: none;
  }

  /* ---------------------------------------------------------------- entrance */
  /* Title pill: wipes open left to right, like a highlighter. */
  :global(.motion) .about__title {
    animation: about-wipe 700ms var(--ease) 120ms both;
  }
  @keyframes about-wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  /* Statement: each line rises out of its own line box. */
  :global(.motion) .about__line {
    overflow: clip;
    overflow-clip-margin: 0.15em;
  }
  :global(.motion) .about__line-inner {
    animation: about-rise 900ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(260ms + var(--enter) * 140ms);
  }
  @keyframes about-rise {
    from {
      translate: 0 110%;
    }
    to {
      translate: none;
    }
  }
  /* The rest: the site's reveal (global.css), continuing the stagger. */
  :global(.motion) .about__enter {
    animation: reveal 800ms cubic-bezier(0.22, 1, 0.36, 1) both;
    animation-delay: calc(260ms + var(--enter) * 140ms);
  }

  /* ---------------------------------------------------------------- responsive */
  @media (max-width: 1239px) {
    .about__story-grid {
      gap: 48px;
    }
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .closing {
      padding: 64px 60px;
    }
  }
  @media (max-width: 1023px) {
    .about {
      --space-section: 96px;
    }
    .about__intro {
      margin-top: 64px;
    }
    .about__story-grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .founder {
      position: static;
    }
    .closing {
      flex-direction: column;
      align-items: flex-start;
      padding: 48px 40px;
    }
  }
  @media (max-width: 767px) {
    .about {
      --space-section: 64px;
      padding-bottom: 40px;
    }
    .about__intro {
      gap: 24px;
      margin-top: 40px;
    }
    .about__heading {
      margin-bottom: 32px;
    }
    .about__text {
      gap: 32px;
    }
    .about__block {
      gap: 12px;
    }
    .founder {
      gap: 32px;
      padding: 40px 24px;
    }
    .founder__who {
      padding-top: 24px;
    }
    .values {
      grid-template-columns: minmax(0, 1fr);
    }
    .value {
      gap: 24px;
      padding: 32px 24px;
    }
    .closing {
      gap: 32px;
      padding: 40px 24px;
    }
  }
</style>
